# Copy outside Git, chmod 0600, and replace every REQUIRED value.
# LibreChat and its database are separate from the Gateway deployment.
DOMAIN_CLIENT=https://librechat.example.com
DOMAIN_SERVER=https://librechat.example.com
AI_GATEWAY_BASE_URL=https://gateway.example.com/v1
MONGO_URI=REQUIRED_AUTHENTICATED_MONGODB_URI
PORT=3080
HOST=0.0.0.0
ENDPOINTS=custom,agents
CONFIG_PATH=/app/librechat.yaml

ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
OPENID_CLIENT_ID=librechat
OPENID_CLIENT_SECRET=REQUIRED_DISTINCT_KEYCLOAK_CLIENT_SECRET
OPENID_ISSUER=https://identity.example.com/realms/gateway-users
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_SCOPE=openid profile email
OPENID_USE_PKCE=true
OPENID_GENERATE_NONCE=true
OPENID_REUSE_TOKENS=true
OPENID_AUDIENCE=gateway
OPENID_REFRESH_AUDIENCE=gateway
OPENID_REUSE_MAX_SESSION_AGE_MS=60000
OPENID_CLOCK_TOLERANCE=5
OPENID_USE_END_SESSION_ENDPOINT=true
SESSION_COOKIE_SECURE=true

# Independent LibreChat application secrets; do not reuse Gateway service keys.
# Generate CREDS_KEY as 32 random bytes in hex, CREDS_IV as 16 bytes in hex.
CREDS_KEY=REQUIRED_64_HEX_CHARACTERS
CREDS_IV=REQUIRED_32_HEX_CHARACTERS
JWT_SECRET=REQUIRED_RANDOM_SESSION_SECRET
JWT_REFRESH_SECRET=REQUIRED_DISTINCT_RANDOM_REFRESH_SECRET
OPENID_SESSION_SECRET=REQUIRED_DISTINCT_RANDOM_OAUTH_SESSION_SECRET

# Gateway owns chargeable quotas, prices, and financial accounting.
CHECK_BALANCE=false
DEBUG_LOGGING=false
DEBUG_CONSOLE=false
DEBUG_OPENAI=false
DEBUG_OPENID_REQUESTS=false
